# Copy this file to .env and fill in your own keys.
# Never commit .env to version control.

# Firebase — https://console.firebase.google.com
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# USDA FoodData Central — https://fdc.nal.usda.gov/api-key-signup
EXPO_PUBLIC_USDA_API_KEY=

# Hugging Face — https://huggingface.co/settings/tokens
EXPO_PUBLIC_HF_TOKEN=

# Gemini / Google AI Studio — https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=

# Release keystore (for local Android builds)
ADAPTCAL_RELEASE_STORE_PASSWORD=
ADAPTCAL_RELEASE_KEY_ALIAS=
ADAPTCAL_RELEASE_KEY_PASSWORD=
